# ============================================================
# CSP Document Generation & Email Automation Platform
# Environment Configuration Template
# ============================================================
# Copy this file to backend/.env and fill in actual values
# (the backend reads .env from its working directory, backend/).
# NEVER commit the .env file to version control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=changeme-generate-a-secure-random-key
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
DATABASE_HOST=localhost
# docker-compose publishes PostgreSQL on host port 5433
DATABASE_PORT=5433
DATABASE_NAME=cspdocmaker
DATABASE_USER=cspdocmaker
DATABASE_PASSWORD=changeme
# Logs every SQL statement WITH bound values (CSP personal data). Keep false.
DATABASE_ECHO=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT Authentication ----
JWT_SECRET_KEY=changeme-generate-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- OTP Configuration ----
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_MINUTE=3

# ---- Google Sheets API (Authorization Source) ----
# TODO: REQUIRES_INPUT — Google API credentials
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google_service_account.json
GOOGLE_SHEETS_ID=changeme-your-google-sheet-id
GOOGLE_SHEETS_RM_SHEET_NAME=RMs
GOOGLE_SHEETS_ADMIN_SHEET_NAME=Admins
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=15

# ---- CSP data Google Sheet (live CSP source) ----
# REQUIRED: spreadsheet ID from the sheet URL. Share the sheet with the
# service account's client_email as Editor (corrections are written back).
GOOGLE_SHEETS_CSP_SHEET_ID=changeme-your-csp-sheet-id
GOOGLE_SHEETS_CSP_SHEET_NAME=KOData
GOOGLE_SHEETS_SUBKO_SHEET_NAME=SUBKOData
CSP_SYNC_INTERVAL_MINUTES=1

# ---- Email delivery ----
# smtp | gmail_api | console  (console only works when APP_ENV=development)
EMAIL_METHOD=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CSP DocMaker

# ---- Gmail / Google Workspace API (EMAIL_METHOD=gmail_api) ----
GMAIL_SENDER_EMAIL=noreply@eko.co.in
GMAIL_CREDENTIALS_FILE=credentials/gmail_service_account.json

# stub | http  (stub only works when APP_ENV=development)

# ---- AI Validation Agent ----
# Provider not yet decided — the AI layer is not implemented and nothing reads
# these values today.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_VALIDATION_TIMEOUT_SECONDS=30

# ---- Document Generation ----
DOCUMENT_TEMPLATES_DIR=../templates/documents
DOCUMENT_OUTPUT_DIR=generated_documents

# ---- Email Domain Restriction ----
# Comma-separated — every domain allowed to sign in.
ALLOWED_EMAIL_DOMAIN=eko.co.in,ekosupport.in

# ---- Celery ----
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# TEMPORARY: generate documents with a placeholder photo box until CSP photos
# are extracted from the CRM. Set to false to require a real CSP photo.
PHOTO_PLACEHOLDER_ALLOWED=false

# ---- PDF conversion ----
# Generated DOCX files are converted to PDF with LibreOffice in headless mode;
# the PDF is what the CSP receives by email. Both formats are stored in
# PostgreSQL permanently.
# Leave LIBREOFFICE_PATH empty to auto-detect: PATH first (Linux), then the
# standard Windows install directory. Set it to pin a specific install, e.g.
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
LIBREOFFICE_PATH=
PDF_CONVERSION_TIMEOUT_SECONDS=120


# ---- WhatsApp (Eko bulk sender) ----
# Sending is not implemented yet; this is where the credential will live.
# Put the real key in backend/.env, which is git-ignored. Never here —
# .env.example IS committed.
WHATSAPP_API_URL=https://indev.eko.in/whatsapp/mcp
WHATSAPP_API_KEY=

# AI studio portrait (Google Gemini). Leave the key empty to switch it off.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
PHOTO_AI_PORTRAIT=true
FACE_MATCH_THRESHOLD=0.75

# AI studio portrait provider: cloudflare (free daily allowance) or gemini
PHOTO_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
