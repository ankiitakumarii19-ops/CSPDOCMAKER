     "expect": {"all": true}},
    {"id": "CON-04", "kind": "connection", "rule": "No. 210", "title": "Passwords and keys are kept locked",
     "input": {"secret": ["smtp_password", "zoho_client_secret", "zoho_refresh_token"]},
     "expect": {"all": true}},
    {"id": "CON-05", "kind": "connection", "rule": "No. 210", "title": "Chat: a password is never taken in the chat",
     "input": {"chat": "set smtp password to abc123"},
     "expect": {"problem": "don't type a password"}},
    {"id": "CON-06", "kind": "connection", "rule": "No. 210", "title": "Chat: 'test my sheet' tests the sheets only",
     "input": {"chat": "test my sheet"},
     "expect": {"tests": ["sheets"]}},
    {"id": "CON-07", "kind": "connection", "rule": "No. 210", "title": "Chat: 'check email of a CSP' is not a connection test",
     "input": {"chat": "check email of csp 1A850498"},
     "expect": {"none": true}},

    {"id": "DAT-01", "kind": "data", "rule": "No. 211", "title": "Eko's record types stay KO = 8, Sub-KO = 9 or 10",
     "input": {"codes": ["1A850344", "1A8503447", "1A85034408", "1A85"]},
     "expect": {"levels": ["ko", "sub_ko", "sub_ko", null]}},
    {"id": "DAT-02", "kind": "data", "rule": "No. 211", "title": "Guess: another company's headings",
     "input": {"headers": ["Agent Code", "Full Name", "Phone", "Email ID", "SOL ID", "Remarks"]},
     "expect": {"guess": {"csp_code": "Agent Code", "name": "Full Name", "mobile": "Phone", "email": "Email ID", "branch_code": "SOL ID"}}},
    {"id": "DAT-03", "kind": "data", "rule": "No. 211", "title": "Guess: Eko's own headings are 'sure'",
     "input": {"headers": ["CSP Code", "CSP Mobile Number"]},
     "expect": {"guess": {"csp_code": "CSP Code", "mobile": "CSP Mobile Number"}, "score": 1.0}},
    {"id": "DAT-04", "kind": "data", "rule": "No. 211", "title": "Guess: one heading is never given to two fields",
     "input": {"headers": ["Branch Code"]},
     "expect": {"guess": {"branch_code": "Branch Code"}}},
    {"id": "DAT-05", "kind": "data", "rule": "No. 211", "title": "Only headings that differ from Eko's are kept",
     "input": {"store": {"csp_code": "CSP Code", "mobile": "Phone"}},
     "expect": {"kept": {"mobile": "Phone"}}},

    {"id": "CATCH-01", "kind": "catch_up", "rule": "No. 259", "title": "Answer did not reach the sheet: all of it is written again",
     "input": {"answers": [{"values": {"address": "Ward 9, Pakur", "email": "csp@example.com"}, "sheet_error": "quota exceeded"}]},
     "expect": {"rewrite": {"address": "Ward 9, Pakur", "email": "csp@example.com"}}},
    {"id": "CATCH-02", "kind": "catch_up", "rule": "No. 259", "title": "A later answer that did reach the sheet wins over the failed older one",
     "input": {"answers": [{"values": {"address": "Ward 9, Pakur", "email": "old@example.com"}, "sheet_error": "quota exceeded"},
                           {"values": {"address": "Ward 10, Pakur"}, "sheet_error": null}]},
     "expect": {"rewrite": {"address": "Ward 10, Pakur", "email": "old@example.com"}}},
    {"id": "CATCH-03", "kind": "catch_up", "rule": "No. 259", "title": "Every answer reached the sheet: nothing to write again, only put in line",
     "input": {"answers": [{"values": {"address": "Ward 9, Pakur"}, "sheet_error": null}]},
     "expect": {"rewrite": {}}}
  ]
}
