     "expect": {"level": "ko", "documents": ["csp_id_card", "csp_certificate", "training_certificate", "bcp"]}},
    {"id": "DOC-02", "kind": "documents", "rule": "No. 57", "title": "A 9-character code is a Sub-KO: never a BCP",
     "input": {"code": "1A9900011"},
     "expect": {"level": "sub_ko", "documents": ["csp_id_card", "csp_certificate", "training_certificate"], "parent": "1A990001"}},
    {"id": "DOC-03", "kind": "documents", "rule": "No. 57", "title": "A 10-character code is a Sub-KO too",
     "input": {"code": "1A99000112"},
     "expect": {"level": "sub_ko", "documents": ["csp_id_card", "csp_certificate", "training_certificate"], "parent": "1A990001"}},
    {"id": "DOC-04", "kind": "documents", "rule": "No. 57", "title": "Spaces around the code do not change the level",
     "input": {"code": " 1A990001 "},
