    {"id": "VER-03", "kind": "verify", "rule": "No. 171", "title": "RBO with and without its place name: not a difference",
     "input": {"field": "rbo_name", "answered": "RBO 6 Samastipur", "current": "RBO 6", "reached": true},
     "expect": {"decision": null}},
    {"id": "VER-04", "kind": "verify", "rule": "No. 171", "title": "Sheet changed after the answer reached it: the sheet's newer value stays",
     "input": {"field": "email", "answered": "first.try@example.com", "current": "fixed.later@example.com", "reached": true, "before": "old@example.com"},
     "expect": {"decision": "kept_sheet", "value": "fixed.later@example.com"}},
    {"id": "VER-05", "kind": "verify", "rule": "No. 171", "title": "Answer never reached the sheet, sheet untouched since: the answer is written",
     "input": {"field": "branch_code", "answered": "8475", "current": "8474", "reached": false, "before": "8474"},
     "expect": {"decision": "wrote_answer", "value": "8475"}},
    {"id": "VER-06", "kind": "verify", "rule": "No. 171", "title": "Answer never reached the sheet, sheet changed since: the sheet's value stays",
     "input": {"field": "branch_code", "answered": "8475", "current": "8476", "reached": false, "before": "8474"},
     "expect": {"decision": "kept_sheet", "value": "8476"}},

    {"id": "MSG-01", "kind": "message", "rule": "No. 174", "title": "A person's own message may go to an existing CSP",
     "input": {"on_hold": "", "existing": true, "kind": "custom"}, "expect": {"allowed": true}},
    {"id": "MSG-02", "kind": "message", "rule": "No. 174", "title": "The details form never goes to an existing CSP",
     "input": {"on_hold": "", "existing": true, "kind": "details_form"}, "expect": {"allowed": false, "says": "existing CSP"}},
    {"id": "MSG-03", "kind": "message", "rule": "No. 174", "title": "Nothing goes to a CSP on hold, even a person's own message",
     "input": {"on_hold": "Not live yet", "existing": false, "kind": "custom"}, "expect": {"allowed": false, "says": "on hold"}},
    {"id": "MSG-04", "kind": "message", "rule": "No. 174", "title": "An old CSP from the Calling sheet may get the details form",
     "input": {"on_hold": "", "existing": false, "kind": "details_form"}, "expect": {"allowed": true}},

    {"id": "ACC-01", "kind": "access", "rule": "No. 175", "title": "An RM may open and act on their own CSP",
     "input": {"role": "rm", "user": "rm.one@example.com", "csp_rm_email": "rm.one@example.com", "rm_resolution": "matched"},
     "expect": {"allowed": true}},
    {"id": "ACC-02", "kind": "access", "rule": "No. 175", "title": "Where RMs keep to their own CSPs, an RM may not act on another RM's CSP (it opens view only)",
     "input": {"role": "rm", "user": "rm.one@example.com", "csp_rm_email": "rm.two@example.com", "rm_resolution": "matched", "scope": "own"},
     "expect": {"allowed": false}},
    {"id": "ACC-05", "kind": "access", "rule": "No. 234", "title": "Eko: any RM may act on any CSP - another RM's too",
     "input": {"role": "rm", "user": "rm.one@example.com", "csp_rm_email": "rm.two@example.com", "rm_resolution": "matched", "scope": "all"},
     "expect": {"allowed": true}},
    {"id": "ACC-03", "kind": "access", "rule": "No. 175", "title": "An RM may act on a CSP whose RM was not found",
     "input": {"role": "rm", "user": "rm.one@example.com", "csp_rm_email": "", "rm_resolution": "unresolved"},
     "expect": {"allowed": true}},
    {"id": "ACC-04", "kind": "access", "rule": "No. 175", "title": "An Admin may act on any CSP",
     "input": {"role": "admin", "user": "admin@example.com", "csp_rm_email": "rm.two@example.com", "rm_resolution": "matched"},
     "expect": {"allowed": true}},

    {"id": "EDIT-01", "kind": "edit", "rule": "No. 175", "title": "A CSP's name cannot be made blank",
     "input": {"column": "CSP Name", "field": "name", "value": "  "}, "expect": {"problem": "Cannot be blank."}},
    {"id": "EDIT-02", "kind": "edit", "rule": "No. 175", "title": "Two mobile numbers in one cell are accepted",
     "input": {"column": "Mobile Number", "field": "mobile", "value": "9812345678 / 9000000123"}, "expect": {"problem": null}},
    {"id": "EDIT-03", "kind": "edit", "rule": "No. 175", "title": "A mobile that is not 10 digits is refused",
     "input": {"column": "Mobile Number", "field": "mobile", "value": "981234"}, "expect": {"problem": "Not a 10-digit Indian mobile number."}},
    {"id": "EDIT-04", "kind": "edit", "rule": "No. 175", "title": "A wrong email is refused",
     "input": {"column": "Email ID", "field": "email", "value": "csp.example.com"}, "expect": {"problem": "Not an email address."}},
    {"id": "EDIT-05", "kind": "edit", "rule": "No. 175", "title": "A blank email may be saved (it is not required)",
     "input": {"column": "Email ID", "field": "email", "value": ""}, "expect": {"problem": null}},
    {"id": "EDIT-06", "kind": "edit", "rule": "No. 175", "title": "The CSP code can never be edited",
     "input": {"column": "CSP Code", "field": "csp_code", "value": "1A990601"}, "expect": {"locked": true}},

    {"id": "LINK-01", "kind": "link", "rule": "No. 192-193", "title": "Every hand send is a new link valid 3 days; the earlier one closes",
     "input": {"code": "1A990701", "sends": [{"by_hand": true, "reaches": true}, {"by_hand": true, "reaches": true}, {"by_hand": true, "reaches": true}]},
     "expect": {"sent": [true, true, true], "links": ["cancelled", "cancelled", "open"], "valid_days": 3}},
    {"id": "LINK-02", "kind": "link", "rule": "No. 192", "title": "The app's own ask does not send a second link while one is open",
     "input": {"code": "1A990702", "sends": [{"by_hand": false, "reaches": true}, {"by_hand": false, "reaches": true}]},
     "expect": {"sent": [true, false], "links": ["open"], "valid_days": 3}},
    {"id": "LINK-03", "kind": "link", "rule": "No. 193", "title": "A hand send that does not reach the CSP keeps their earlier link working",
     "input": {"code": "1A990703", "sends": [{"by_hand": true, "reaches": true}, {"by_hand": true, "reaches": false}]},
     "expect": {"sent": [true, false], "links": ["open", "cancelled"], "valid_days": 3}},

    {"id": "SEND-01", "kind": "force", "rule": "No. 195", "title": "A message a person sends goes even if the same words went in the last 15 minutes",
     "input": {"sent_by": "rm.one@example.com"}, "expect": {"force": true}},
    {"id": "SEND-02", "kind": "force", "rule": "No. 195", "title": "The app's own messages keep the 15-minute protection",
     "input": {"sent_by": null}, "expect": {"force": false}},

    {"id": "WHO-01", "kind": "sender", "rule": "No. 194", "title": "A message an RM sent shows the RM's name and role",
     "input": {"sent_by": "rm.one@example.com", "because": "sent_by_a_person", "me": "admin@example.com",
               "names": {"rm.one@example.com": ["Rm One", "rm"]}},
     "expect": {"label": "Rm One", "role": "rm"}},
    {"id": "WHO-02", "kind": "sender", "rule": "No. 194", "title": "A message I sent shows 'You'",
     "input": {"sent_by": "admin@example.com", "because": "sent_by_a_person", "me": "admin@example.com",
               "names": {"admin@example.com": ["Admin", "super_admin"]}},
     "expect": {"label": "You", "role": "super_admin"}},
    {"id": "WHO-03", "kind": "sender", "rule": "No. 194", "title": "A hand-sent message from before senders were recorded",
     "input": {"sent_by": null, "because": "sent_by_a_person", "me": "admin@example.com", "names": {}},
     "expect": {"label": "A person (who was not recorded)", "role": ""}},
    {"id": "WHO-04", "kind": "sender", "rule": "No. 194", "title": "The app's own message shows 'Automatic'",
     "input": {"sent_by": null, "because": null, "me": "admin@example.com", "names": {}},
     "expect": {"label": "Automatic", "role": ""}},

    {"id": "SET-01", "kind": "setting", "rule": "No. 204", "title": "Eko's sending hours stay 8 am - 8 pm, India time",
     "input": {"standard": ["verify_start_hour", "verify_end_hour", "send_time_zone"]},
     "expect": {"values": [8, 20, "+05:30"]}},
    {"id": "SET-02", "kind": "setting", "rule": "No. 204", "title": "A failed WhatsApp: first wait 30 minutes, longest 4 hours, alternate number after 5 failed tries (never given up, No. 237)",
     "input": {"standard": ["resend_first_wait_minutes", "resend_longest_wait_hours", "resend_handover_tries"]},
     "expect": {"values": [30, 4, 5]}},
    {"id": "SET-03", "kind": "setting", "rule": "No. 204", "title": "Replies: last 72 hours, 5 quiet minutes, at most 3 automatic a day",
     "input": {"standard": ["reply_lookback_hours", "reply_quiet_minutes", "reply_auto_per_day"]},
     "expect": {"values": [72, 5, 3]}},
    {"id": "SET-04", "kind": "setting", "rule": "No. 204", "title": "Form link 3 days, document link 7 days, feedback 15 minutes after",
     "input": {"standard": ["data_request_expiry_days", "documents_link_days", "documents_feedback_after_minutes"]},
     "expect": {"values": [3, 7, 15]}},
    {"id": "SET-05", "kind": "setting", "rule": "No. 204", "title": "Chat: 'set feedback delay to 30 minutes'",
     "input": {"chat": "set feedback delay to 30 minutes"},
     "expect": {"key": "documents_feedback_after_minutes", "value": 30}},
    {"id": "SET-06", "kind": "setting", "rule": "No. 204", "title": "Chat: '7 pm' is hour 19",
     "input": {"chat": "change messages stop at to 7 pm"},
     "expect": {"key": "verify_end_hour", "value": 19}},
    {"id": "SET-07", "kind": "setting", "rule": "No. 204", "title": "Chat: 'time zone 5:30' is +05:30",
     "input": {"chat": "set time zone to 5:30"},
     "expect": {"key": "send_time_zone", "value": "+05:30"}},
    {"id": "SET-08", "kind": "setting", "rule": "No. 204", "title": "Chat: a value outside the safe range is refused with the range",
     "input": {"chat": "set form link to 99 days"},
     "expect": {"key": "data_request_expiry_days", "problem": "from 1 to 30"}},
    {"id": "SET-09", "kind": "setting", "rule": "No. 204", "title": "Chat: a 'make ... to ...' that is not a setting is left to the rest of the chat",
     "input": {"chat": "make a dashboard to show rms"},
     "expect": {"key": null}},
    {"id": "SET-10", "kind": "setting", "rule": "No. 204", "title": "Messages must start before they stop",
     "input": {"together": {"verify_start_hour": 9, "verify_end_hour": 9}},
     "expect": {"problem": "start before they stop"}},

    {"id": "FEA-01", "kind": "feature", "rule": "No. 206", "title": "Nothing changed: an RM finds CSPs and makes documents, no Dashboard",
     "input": {"role": "rm", "email": "rm.one@example.com", "grants": {}},
     "expect": {"has": ["csp_search", "documents", "database", "sheets"], "not": ["dashboard", "whatsapp", "settings"]}},
    {"id": "FEA-02", "kind": "feature", "rule": "No. 206", "title": "Nothing changed: an Admin has the Dashboard, not making documents",
     "input": {"role": "admin", "email": "admin@example.com", "grants": {}},
     "expect": {"has": ["dashboard", "whatsapp", "settings", "csp_message"], "not": ["documents", "agents", "feature_access"]}},
    {"id": "FEA-03", "kind": "feature", "rule": "No. 206", "title": "The Super Admin keeps everything, even if a row says otherwise",
     "input": {"role": "super_admin", "email": "owner@example.com", "grants": {"dashboard|person:owner@example.com": false}},
     "expect": {"has": ["dashboard", "agents", "feature_access", "access"], "not": ["documents"]}},
    {"id": "FEA-04", "kind": "feature", "rule": "No. 206", "title": "Taken from the Admin role: every Admin loses it",
     "input": {"role": "admin", "email": "admin@example.com", "grants": {"whatsapp|role:admin": false}},
     "expect": {"has": ["emails"], "not": ["whatsapp"]}},
    {"id": "FEA-05", "kind": "feature", "rule": "No. 206", "title": "One person differs from their role",
     "input": {"role": "admin", "email": "admin@example.com", "grants": {"whatsapp|role:admin": false, "whatsapp|person:admin@example.com": true}},
     "expect": {"has": ["whatsapp"], "not": []}},
    {"id": "FEA-06", "kind": "feature", "rule": "No. 206", "title": "Making documents cannot be given to an Admin, even by a row",
     "input": {"role": "admin", "email": "admin@example.com", "grants": {"documents|role:admin": true}},
     "expect": {"has": [], "not": ["documents"]}},
    {"id": "FEA-07", "kind": "feature", "rule": "No. 206", "title": "Access (adding people) stays as it is, whatever a row says",
     "input": {"role": "rm", "email": "rm.one@example.com", "grants": {"access|role:rm": true, "feature_access|role:rm": true}},
     "expect": {"has": [], "not": ["access", "feature_access"]}},
    {"id": "FEA-08", "kind": "feature", "rule": "No. 206", "title": "An own role built on RM, given the Dashboard",
     "input": {"role": "rm", "email": "rm.one@example.com", "grants": {"dashboard|role:field-officer": true}, "roles": {"field-officer": {"name": "Field officer", "base": "rm", "scope": "all"}}, "members": {"rm.one@example.com": "field-officer"}},
     "expect": {"has": ["dashboard", "documents"], "not": [], "scope": "all"}},
    {"id": "FEA-09", "kind": "feature", "rule": "No. 206", "title": "Chat: 'give RMs the dashboard'",
     "input": {"chat": "give RMs the dashboard"},
     "expect": {"feature": "dashboard", "subject": "rm", "allowed": true}},
    {"id": "FEA-10", "kind": "feature", "rule": "No. 206", "title": "Chat: 'take whatsapp messages from admins'",
     "input": {"chat": "take whatsapp messages from admins"},
     "expect": {"feature": "whatsapp", "subject": "admin", "allowed": false}},
    {"id": "FEA-11", "kind": "feature", "rule": "No. 206", "title": "Removing a sheet is not 'editing sheet rows'",
     "input": {"routes": [["DELETE", "/api/admin/sheets/{source_id}"], ["PATCH", "/api/admin/sheets/{source_id}/tabs/{tab}/rows/{row_number}"]]},
     "expect": {"features": ["sheet_connections", "sheets"]}},

    {"id": "CON-01", "kind": "connection", "rule": "No. 210", "title": "A sheet link becomes the sheet's id",
     "input": {"key": "google_sheets_csp_sheet_id", "value": "https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcd/edit#gid=0"},
     "expect": {"value": "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcd"}},
    {"id": "CON-02", "kind": "connection", "rule": "No. 210", "title": "Something that is not a sheet is refused",
     "input": {"key": "google_sheets_csp_sheet_id", "value": "my sheet"},
