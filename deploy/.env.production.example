# CSPdocMaker — settings for the server.
#
# Copy this file to deploy/.env.production ON THE SERVER and fill it in.
# deploy/.env.production is git-ignored: it never goes to GitHub.
#
# Values marked COPY: take them from backend/.env on the laptop where the
# app already works. Values marked NEW: make a fresh one for the server —
#   openssl rand -hex 32
# Never reuse the laptop's secret keys on the server.

# ---- The web address ------------------------------------------------------
# NEW: your domain, no https://
DOMAIN=docs.example.com
# NEW: the same, with https://
PUBLIC_APP_URL=https://docs.example.com
# Set by make-env.sh when the app lives under a path of a domain another
# web server already serves (e.g. indev.eko.in/csp-docmaker): the path, the
# Caddy configuration for that case, and the private ports Caddy uses.
BASE_PATH=
CADDYFILE=Caddyfile
HTTP_BIND=80
HTTPS_BIND=443

# ---- Application ------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
# NEW: openssl rand -hex 32
APP_SECRET_KEY=
# NEW: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# A sign-in lasts until logout or this many hours (No. 100).
SESSION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (runs inside Docker; host/port are set by the compose file) --
DATABASE_NAME=cspdocmaker
DATABASE_USER=cspdocmaker
# NEW: openssl rand -hex 24
DATABASE_PASSWORD=
DATABASE_ECHO=false

# ---- Who may sign in ----------------------------------------------------------
ALLOWED_EMAIL_DOMAIN=eko.co.in,ekosupport.in
# COPY
SUPER_ADMIN_EMAILS=
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=3

# ---- Google Sheets ----------------------------------------------------------
# The service-account file goes in backend/credentials/ on the server
# (copied by hand — never through GitHub).
# COPY
GOOGLE_SHEETS_ID=
# COPY if different
GOOGLE_SHEETS_RM_SHEET_NAME=RMs
# COPY if different
GOOGLE_SHEETS_ADMIN_SHEET_NAME=Admins
# COPY
GOOGLE_SHEETS_CSP_SHEET_ID=
GOOGLE_SHEETS_CSP_SHEET_NAME=KOData
GOOGLE_SHEETS_SUBKO_SHEET_NAME=SUBKOData
# COPY if different
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=15
# COPY if different
CSP_SYNC_INTERVAL_MINUTES=15

# ---- Calling + Lead raw data sheets (tracker No. 121, Eko only) ----
# Set the two ids here (and ONLY on the server) to switch the job on. Both
# sheets must be shared with the service account (Viewer is enough).
CALLING_SHEET_ID=
CALLING_SHEET_TAB=Calling Sheet New
CALLING_HEADER_ROW=2
LEAD_SHEET_ID=
LEAD_SHEET_TAB=Lead raw data
LEAD_HEADER_ROW=1
LEAD_LIVE_REMARK=Go Live Done
SOURCE_SHEETS_INTERVAL_MINUTES=5


# ---- Old CSPs asked to verify their details (No. 126) ----
# Only where CALLING_SHEET_ID is set. 25 every 15 min, 8 am-8 pm IST.
VERIFY_OLD_CSPS_ENABLED=true
VERIFY_BATCH_SIZE=25
VERIFY_INTERVAL_MINUTES=15
VERIFY_START_HOUR=8
VERIFY_END_HOUR=20
VERIFY_STOP_AFTER=5
# The temporary Address tab (No. 129). Empty id = the CSPDATA sheet.
# Verification waits until it has been read once.
ADDRESS_SHEET_ID=
ADDRESS_SHEET_TAB=Address
VERIFY_WAIT_FOR_ADDRESS=true

# ---- Email tracking (No. 127): bounces read from the SMTP inbox ----
IMAP_HOST=imap.gmail.com
EMAIL_BOUNCE_MINUTES=15

# ---- Email ---------------------------------------------------------------------
# COPY
EMAIL_METHOD=smtp
# COPY
SMTP_HOST=smtp.gmail.com
# COPY
SMTP_PORT=587
# COPY
SMTP_USE_TLS=true
# COPY
SMTP_USERNAME=
# COPY (the Gmail App Password)
SMTP_PASSWORD=
# COPY
SMTP_FROM_EMAIL=
# COPY
# true = no email goes out except sign-in codes (No. 133). Documents due
# wait and are mailed once it is false again.
EMAILS_PAUSED=false
SMTP_FROM_NAME=

# ---- Zoho CRM (CSP photos) ---------------------------------------------------------
# COPY
ZOHO_DATA_CENTRE=
# COPY
ZOHO_CLIENT_ID=
# COPY
ZOHO_CLIENT_SECRET=
# COPY
ZOHO_REFRESH_TOKEN=

# ---- WhatsApp (Eko's hosted platform — no key needed) ---------------------------------
WHATSAPP_PLATFORM_URL=https://indev.eko.in/whatsapp/mcp
WHATSAPP_LANGUAGE=en_US
# WhatsApp messages screen (No. 110): how often delivered / read / replied is
# fetched, and for how many days after a send.
WHATSAPP_STATUS_MINUTES=10
WHATSAPP_STATUS_DAYS=7

# ---- Documents and photos ------------------------------------------------------------
PDF_CONVERSION_TIMEOUT_SECONDS=120
# COPY
PHOTO_PLACEHOLDER_ALLOWED=false
